<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:layout_marginBottom="8dp" android:background="#FFFFFF" android:elevation="2dp"
    android:orientation="vertical" android:padding="16dp">
    <TextView android:id="@+id/textNomeProduto" android:layout_width="wrap_content"
        android:layout_height="wrap_content" android:text="Nome do Produto" android:textColor="#2D3748"
        android:textSize="17sp" android:textStyle="bold" />
    <TextView android:id="@+id/textPrecoProduto" android:layout_width="wrap_content"
        android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="R$ 0,00"
        android:textColor="#2B6CB0" android:textSize="15sp" />
    <ImageView
        android:id="@+id/imgProduto"
        android:layout_width="80dp"
        android:layout_height="80dp"
        android:scaleType="centerCrop" />
</LinearLayout>